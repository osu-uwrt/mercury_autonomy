<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4"
      main_tree_to_execute="Move">
  <BehaviorTree ID="Move">
    <Sequence>
      <WaitForKillSwitch/>
      <Sleep msec="5000"/>
      <ApplyFeedforwardForce linear_x="0"
                             linear_y="0"
                             linear_z="-5"
                             angular_x="0"
                             angular_y="0"
                             angular_z="0"
                             duration="5"/>
      <ApplyFeedforwardForce linear_x="5"
                             linear_y="0"
                             linear_z="-1.1"
                             angular_x="0"
                             angular_y="0"
                             angular_z="0"
                             duration="30"/>
      <Sleep msec="12000"/>
      <ApplyFeedforwardForce linear_x="-5"
                             linear_y="0"
                             linear_z="-1.1"
                             angular_x="0"
                             angular_y="0"
                             angular_z="0"
                             duration="32"/>
    </Sequence>
  </BehaviorTree>

  <!-- Description of Node Models (used by Groot) -->
  <TreeNodesModel>
    <Action ID="ApplyFeedforwardForce"
            editable="true">
      <input_port name="linear_x"
                  type="double"/>
      <input_port name="linear_y"
                  type="double"/>
      <input_port name="linear_z"
                  type="double"/>
      <input_port name="angular_x"
                  type="double"/>
      <input_port name="angular_y"
                  type="double"/>
      <input_port name="angular_z"
                  type="double"/>
      <input_port name="duration"
                  type="double"/>
    </Action>
    <Action ID="WaitForKillSwitch"
            editable="true"/>
  </TreeNodesModel>

</root>
