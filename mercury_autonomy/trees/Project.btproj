<?xml version="1.0" encoding="UTF-8"?>
<root BTCPP_format="4" project_name="Project">
    <include path="../osu-uwrt/development/software/src/mercury_autonomy/mercury_autonomy/trees/triton_gate.xml"/>
    <!-- Description of Node Models (used by Groot) -->
    <TreeNodesModel>
        <Action ID="ApplyFeedforwardForce" editable="true">
            <input_port name="linear_x" type="double"/>
            <input_port name="linear_y" type="double"/>
            <input_port name="linear_z" type="double"/>
            <input_port name="angular_x" type="double"/>
            <input_port name="angular_y" type="double"/>
            <input_port name="angular_z" type="double"/>
            <input_port name="duration" type="double"/>
        </Action>
        <Action ID="GetOdometry" editable="true">
            <output_port name="x" type="double"/>
            <output_port name="y" type="double"/>
            <output_port name="z" type="double"/>
            <output_port name="roll" type="double"/>
            <output_port name="pitch" type="double"/>
            <output_port name="yaw" type="double"/>
        </Action>
        <Action ID="PublishToController" editable="true">
            <input_port name="isOrientation" type="bool"/>
            <input_port name="mode" type="int"/>
            <input_port name="x" type="double"/>
            <input_port name="y" type="double"/>
            <input_port name="z" type="double"/>
        </Action>
        <Action ID="WaitForKillSwitch" editable="true"/>
    </TreeNodesModel>
</root>
