<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>mercury_autonomy</name>
  <version>0.0.0</version>
  <description>BehaviorTree-based autonomy system for the Mercury stack with local BehaviorTree.CPP library integration</description>
  <maintainer email="gupta.1516@osu.edu">Aditya Gupta</maintainer>
  <license>Apache 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS2 dependencies -->
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>rclcpp_components</depend>

  <!-- BehaviorTree.CPP from local subtree -->
  <depend>behaviortree_cpp</depend>

  <!-- Testing dependencies -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
